# Sao chép thành .env (đã nằm trong .gitignore của repo).

NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# ---------------------------------------------------------------------
# Tích hợp V-App
#
# mock  → bật bản mô phỏng tại /__vapp (chỉ dùng khi phát triển)
# real  → gọi thẳng V-App; /__vapp không được đăng ký
#
# Server sẽ TỪ CHỐI KHỞI ĐỘNG nếu NODE_ENV=production mà VAPP_MODE=mock.
# ---------------------------------------------------------------------
VAPP_MODE=mock

# Đây là biến duy nhất phải đổi khi ráp API thật.
VAPP_BASE_URL=http://127.0.0.1:4000/__vapp
# VAPP_BASE_URL=https://api.v-app.vn

# Ở chế độ mock, hai giá trị này chỉ cần khớp nhau giữa gateway và mock.
# Ở chế độ real, lấy tại DevCenter > Cài đặt > Tổng quan của mini app.
VAPP_CLIENT_ID=v-market-dev
VAPP_CLIENT_SECRET=dev-secret

# ---------------------------------------------------------------------
# Phiên đăng nhập của V-Market (không liên quan tới token của V-App)
# ---------------------------------------------------------------------
JWT_SECRET=dev-jwt-secret-doi-truoc-khi-deploy
JWT_TTL_SECONDS=43200

# ---------------------------------------------------------------------
# Tham số của bản mô phỏng
# Giữ ngắn để lỗi hết hạn / dùng lại lộ ra sớm.
# ---------------------------------------------------------------------
MOCK_AUTHCODE_TTL_SECONDS=60
MOCK_ACCESS_TOKEN_TTL_SECONDS=3600
