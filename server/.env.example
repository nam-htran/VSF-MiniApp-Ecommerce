# copy .env.example .env

# "development" is the only value allowed to run on the secrets below.
# Set anything else and the app refuses to start until JWT_SECRET,
# PAYMENT_IPN_SECRET and VAPP_CLIENT_SECRET are your own — they are in
# git, so treat every value in this file as public.
APP_ENV=development

HOST=127.0.0.1
PORT=4000

# The only line to change to use the real API.
# There is no mock/real flag in the code — just this URL.
VAPP_BASE_URL=http://127.0.0.1:4001
# VAPP_BASE_URL=https://api.v-app.vn

# Mock: must match CLIENT_ID / CLIENT_SECRET in mock-openAPI/
# Real: DevCenter > Settings > Overview of the mini app
VAPP_CLIENT_ID=v-market-dev
VAPP_CLIENT_SECRET=dev-secret

# Matches docker-compose.yml. Port 5433 to stay clear of a locally
# installed Postgres on 5432.
DATABASE_URL=postgresql+asyncpg://vmarket:vmarket@127.0.0.1:5433/vmarket

# V-Market's own session, unrelated to V-App tokens. Anyone who knows this
# can forge a token for any user, ADMIN included.
JWT_SECRET=dev-jwt-secret-change-before-deploy
JWT_TTL_SECONDS=43200

# Signs the server-to-server payment notification (HMAC-SHA256). Must equal
# PAYMENT_IPN_SECRET in mock-openAPI/, or every webhook is rejected.
PAYMENT_IPN_SECRET=dev-ipn-secret
# Only ever turn this off to debug a signature locally. Off means anyone
# who can reach the server can claim an order was paid.
PAYMENT_VERIFY_HASH=true

# Stock holds. Placing an order decrements stock immediately — that is the
# hold — and this is how long before an unpaid order hands it back. Short
# on purpose so it is demonstrable in one sitting; a real shop uses hours.
ORDER_HOLD_MINUTES=15
# Extra time once the buyer has opened a payment session: a bank app, an
# OTP and poor signal are all slower than browsing.
PAYMENT_GRACE_MINUTES=30

# Background loop: release expired holds, and ask the gateway about
# payments whose webhook never arrived. Tests set this false — they move
# the clock by hand and must not race a loop doing the same work.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# V-App user ids that get the ADMIN role on login, comma separated. Empty
# means nobody is an operator. Config rather than a database flag because
# there is no admin to grant the first admin. The demo operator:
# ADMIN_VAPP_USER_IDS=44444444-4444-4444-8444-444444444444
ADMIN_VAPP_USER_IDS=

# Reverse geocoding runs server-side: the MiniApp cannot reach a
# third-party host (domain whitelist), but the server can.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
