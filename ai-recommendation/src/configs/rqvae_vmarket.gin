import data.processed
import modules.quantize

train.iterations=5000
train.learning_rate=0.001
train.weight_decay=0.0001
train.batch_size=640

train.dataset_folder="/kaggle/input/vmarket-phase2-embeddings"
train.dataset=%data.processed.RecDataset.VMARKET
train.save_dir_root="/kaggle/working/vmarket_rqvae/"

train.vae_input_dim=256
train.vae_n_cat_feats=0
train.vae_hidden_dims=[256, 128, 64]
train.vae_embed_dim=32
train.vae_codebook_size=256
train.vae_n_layers=3
train.vae_codebook_normalize=False
train.vae_sim_vq=False
train.vae_codebook_mode=%modules.quantize.QuantizeForwardMode.ROTATION_TRICK
train.commitment_weight=0.25

train.use_kmeans_init=True
train.do_eval=True
train.eval_every=2500
train.save_model_every=5000
train.amp=True
train.mixed_precision_type="fp16"
train.wandb_logging=True
