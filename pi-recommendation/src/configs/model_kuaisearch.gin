train.iterations=2000
train.batch_size=1
train.gradient_accumulate_every=16
train.learning_rate=0.00002
train.weight_decay=0.01

train.preprocessed_folder="/kaggle/input/kuaisearch-preprocessed"
train.semantic_ids_path="/kaggle/input/kuaisearch-rqvae/semantic_ids.parquet"
train.save_dir_root="/kaggle/working/model/"

train.model_name="Qwen/Qwen3-0.6B-Base"
train.codebook_sizes=[128, 64, 32]
train.request_keys=["user_id", "session_id", "time_index", "query"]
train.kd_weight=1.0
train.temperature=1.0
train.student_max_length=256
train.teacher_max_length=512

train.train_request_limit=10000
train.validation_request_limit=1000
train.recent_item_limit=20
train.history_request_limit=5
train.eval_every=500
train.save_model_every=2000
train.max_grad_norm=1.0
train.random_seed=2026
train.amp=True

train.wandb_logging=True
train.wandb_project="kuaisearch-privileged-distillation"
train.wandb_run_name_prefix="qwen3-0.6b-base"
