# copy .env.example .env

# The V-Market backend. Read by src/api/client.ts and nothing else.
#
# 127.0.0.1 only resolves in the CLI simulator, where requests are proxied
# through Node on this machine. On a real device the loopback is the phone,
# and the platform only allows HTTPS to whitelisted domains — so this line
# is what changes for device testing, not the application code.
VITE_API_BASE=http://127.0.0.1:4000
